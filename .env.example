# Copy this file to .env for local development.
# Use a MongoDB Atlas connection string; do not commit your real URI.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/pim?retryWrites=true&w=majority
# Replace this with a long, randomly generated secret. Required in production.
JWT_SECRET=replace-with-a-long-random-secret-before-deploying
PORT=10000
NODE_ENV=development
